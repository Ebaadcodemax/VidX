# No provider credentials are needed for the local M1 pipeline.
# Add a provider key only after choosing an approved provider and reviewing
# its pricing, data retention, training, region, and transfer terms.

# Gemini is optional. If enabled, the selected audio file is uploaded to Google.
# Set both acknowledgements to true only after the creator has been told and
# consented, and you accept Google's unpaid-service data-use terms.
GEMINI_API_KEY=
GEMINI_CREATOR_CONSENT=false
GEMINI_UNPAID_DATA_USE_ACK=false
GEMINI_FREE_TIER_ONLY=false
